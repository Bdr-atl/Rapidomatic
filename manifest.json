{
    "manifest_version": 3,
    "name": "Rapidomatic",
    "version": "2.0",
    "description": "Insertion ou remplacement de texte.",
    "permissions": [
        "storage"
    ],
    "icons": {
        "16": "files/icon16.png",
        "48": "files/icon48.png",
        "128": "files/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "files/icon16.png",
            "48": "files/icon48.png",
            "128": "files/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://groupe-atlantic.lightning.force.com/lightning/*"],
            "resources": ["libs/xlsx.full.min.js"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ]
}
